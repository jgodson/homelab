---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /blog/tags/{{ tag | slug }}/
layout: base.njk
eleventyComputed:
  title: "Tag: #{{ tag }} | Jason Godson"
  description: "Notes and writeups tagged with '{{ tag }}'"
---

<div class="comic-page-header">
  <div class="comic-section-heading-wrap">
    <h1 class="comic-section-heading">TAG: #{{ tag }}</h1>
    <span class="comic-marker-underline"></span>
  </div>
  <p class="comic-page-subtitle">All notes and writeups categorized under <code>#{{ tag }}</code></p>
  <div class="comic-filter-bar">
    <a href="/blog/tags/" class="comic-secondary-btn">← View all topics</a>
  </div>
</div>

<div class="comic-notes-list">
  {% for post in collections.blog %}
    {% if tag in post.data.tags %}
      <article class="comic-note-card">
        <div class="comic-note-card-header">
          <h2 class="comic-note-card-title">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>
          <time class="comic-date" datetime="{{ post.date | dateToISO }}">{{ post.date | dateToNoteFormat }}</time>
        </div>
        {% if post.data.description %}
          <p class="comic-note-card-desc">{{ post.data.description }}</p>
        {% endif %}
        <div class="comic-note-card-footer">
          <a href="{{ post.url }}" class="comic-read-link">Read note →</a>
        </div>
      </article>
    {% endif %}
  {% endfor %}

  <div class="comic-back-center">
    <a href="/blog/" class="comic-btn">← Back to all notes</a>
  </div>
</div>