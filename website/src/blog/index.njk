---
layout: base.njk
title: Notes & Articles | Jason Godson
description: Blog posts and notes about technology, software development, side projects, and homelab experiments by Jason Godson.
pagination:
  data: collections.blog
  size: 10
  alias: posts
---

<div class="comic-page-header">
  <div class="comic-section-heading-wrap">
    <h1 class="comic-section-heading">NOTES & LOGS</h1>
    <span class="comic-marker-underline"></span>
  </div>
  <p class="comic-page-subtitle">Ideas, build logs, and technical explorations from a curious maker.</p>
  <div class="comic-filter-bar">
    <a href="/blog/tags/" class="comic-secondary-btn">Browse all tags & topics →</a>
  </div>
</div>

<div class="comic-notes-list">
  {% for post in pagination.items %}
    <article class="comic-note-card">
      <div class="comic-note-card-header">
        <h2 class="comic-note-card-title">
          <a href="{{ post.url }}">{{ post.data.title }}</a>
        </h2>
        <time class="comic-date" datetime="{{ post.date | dateToISO }}">{{ post.date | dateToNoteFormat }}</time>
      </div>

      {% if post.data.tags %}
      <div class="comic-tag-list">
        {% for tag in post.data.tags %}
          {% if tag != "blog" %}
          <a href="/blog/tags/{{ tag | slug }}/" class="comic-tag-pill">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
      
      {% if post.data.description %}
        <p class="comic-note-card-desc">{{ post.data.description }}</p>
      {% endif %}
      
      <div class="comic-note-card-footer">
        <a href="{{ post.url }}" class="comic-read-link">Read note →</a>
      </div>
    </article>
  {% endfor %}

  {% if collections.blog.length === 0 %}
    <p class="comic-empty-msg">No notes published yet. Check back soon!</p>
  {% endif %}
  
  {# Pagination controls #}
  {% if pagination.pages.length > 1 %}
    <nav class="comic-pagination" aria-label="Pagination">
        <div class="comic-pagination-prev">
        {% if pagination.href.previous %}
            <a href="{{ pagination.href.previous }}" class="comic-page-btn">← Previous</a>
        {% else %}
            <span class="comic-page-btn disabled">← Previous</span>
        {% endif %}
        </div>
        
        <div class="comic-pagination-numbers">
        {% for pageNumber in pagination.pages %}
            {% if loop.index == pagination.pageNumber + 1 %}
            <span class="comic-page-btn current">{{ loop.index }}</span>
            {% else %}
            <a href="{{ pagination.hrefs[loop.index0] }}" class="comic-page-btn">{{ loop.index }}</a>
            {% endif %}
        {% endfor %}
        </div>
        
        <div class="comic-pagination-next">
        {% if pagination.href.next %}
            <a href="{{ pagination.href.next }}" class="comic-page-btn">Next →</a>
        {% else %}
            <span class="comic-page-btn disabled">Next →</span>
        {% endif %}
        </div>
    </nav>
  {% endif %}
</div>