---
layout: base.njk
title: Topics | Jason Godson
description: Browse notes and articles by topic, project, and tags.
permalink: /blog/tags/
---

<div class="comic-page-header">
  <div class="comic-section-heading-wrap">
    <h1 class="comic-section-heading">TOPICS</h1>
    <span class="comic-marker-underline"></span>
  </div>
  <p class="comic-page-subtitle">Explore notes, guides, and experiments grouped by topic.</p>
</div>

<div class="comic-tags-container">
  {% if collections.tagList.length %}
    {% for group in collections.tagList | groupTags(collections.blog, tagGroups) %}
      <section class="comic-tag-group">
        <h2 class="comic-tag-group-title">{{ group.title }}</h2>
        <div class="comic-tag-cloud">
          {% for tag in group.tags %}
            <a href="/blog/tags/{{ tag.name | slug }}/" class="comic-tag-bubble">
              <span class="comic-tag-label">#{{ tag.name }}</span>
              <span class="comic-tag-count">{{ tag.count }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% else %}
    <p class="comic-empty-msg">No tags found.</p>
  {% endif %}
  
  <div class="comic-back-center">
    <a href="/blog/" class="comic-btn">← Back to all notes</a>
  </div>
</div>