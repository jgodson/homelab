      "targets": [
        {
          "alias": "Heat",
          "datasource": {
            "type": "influxdb",
            "uid": "aegz2deoojz0gb"
          },
          "query": "SELECT count(\"state\") * 60 AS \"runtime_seconds\" FROM (SELECT last(\"hvac_action_str\") AS \"state\" FROM \"climate.main_floor\" WHERE time >= ${__from}ms - 24h AND time <= ${__to}ms - 1m GROUP BY time(1m) fill(previous)) WHERE time >= ${__from}ms AND time <= ${__to}ms AND \"state\" = 'heating'",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
