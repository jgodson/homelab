[Unit]
Description=MyQ Android H.264 bridge
After=systemd-modules-load.service snap.docker.dockerd.service network-online.target
Requires=snap.docker.dockerd.service
RequiresMountsFor=/home/manager/myq-android/android-data /home/manager/myq-frigate-bridge

[Service]
Type=simple
EnvironmentFile=/etc/myq-frigate-bridge.env
ExecStartPre=/sbin/modprobe binder_linux
ExecStart=/home/manager/myq-frida-venv/bin/python /home/manager/myq-frigate-bridge/myq_android_bridge.py
Restart=always
RestartSec=5
TimeoutStopSec=30
User=root
Group=root
PrivateTmp=true

[Install]
WantedBy=multi-user.target
