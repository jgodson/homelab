# Copy this file to frigate.env on the Frigate host. Never commit frigate.env.
# Use the Camera Account created in the Tapo app, not the Tapo cloud login.
# Values used in RTSP URLs must be URL-encoded. The included
# set-tapo-credentials.sh helper prompts securely, performs the encoding, and
# stores deployment-specific endpoints in the untracked frigate.env file.
FRIGATE_TAPO_LOCAL_USER=replace_me
FRIGATE_TAPO_LOCAL_PASSWORD=replace_me
FRIGATE_TAPO_LOCAL_HOST=replace_with_camera_host_and_port
FRIGATE_TAPO_RV_HOST=replace_with_tailnet_proxy_host_and_port
FRIGATE_WYZE_CAM2_USER=replace_me
FRIGATE_WYZE_CAM2_PASSWORD=replace_me
